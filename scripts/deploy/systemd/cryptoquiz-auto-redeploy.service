[Unit]
Description=CryptoQuiz automatic redeploy
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
WorkingDirectory=__REPO_ROOT__
ExecStart=/usr/bin/env bash __REPO_ROOT__/scripts/deploy/auto-redeploy.sh
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
